@model List<Product>

<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>ID</th>
            <th>NameProduct</th>
            <th>Salary</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.Salary</td>
            </tr>
        }
    </tbody>
</table>